# 발송 채널
SEND_EMAIL=1
SEND_KAKAO=1

# 카카오 사용 시 본인에게도 보낼지
KAKAO_SEND_TO_SELF=1

# 테스트 강제 발송
FORCE_SEND=0

# 메일
SMTP_HOST=smtp.naver.com
SMTP_PORT=587
SMTP_USER=your_email@naver.com
SMTP_PASSWORD=your_password
MAIL_FROM=your_email@naver.com

# 카카오
KAKAO_REST_API_KEY=your_rest_api_key
KAKAO_CLIENT_SECRET=your_client_secret
KAKAO_MESSAGE_LINK_URL=https://94hjlee-debug.github.io/mail-kakao-send/